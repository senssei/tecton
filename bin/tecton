#!/usr/bin/env bash
# Tecton developer CLI runner
# Runs the local workspace version of Tecton without requiring manual venv activation.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# 1. Prefer local repository virtualenv if present
if [[ -f "${ROOT_DIR}/.venv/bin/python" ]]; then
    export PYTHONPATH="${ROOT_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
    exec "${ROOT_DIR}/.venv/bin/python" -m tecton_arch.cli.main "$@"
fi

# 2. Fall back to uv run if available
if command -v uv >/dev/null 2>&1; then
    exec uv run --project "${ROOT_DIR}" tecton "$@"
fi

# 3. Fall back to system python3
if command -v python3 >/dev/null 2>&1; then
    export PYTHONPATH="${ROOT_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
    exec python3 -m tecton_arch.cli.main "$@"
fi

echo "Error: Neither Python 3 nor uv was found." >&2
exit 1
